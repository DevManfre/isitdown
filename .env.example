# Secrets are injected at runtime and never committed.
# Copy to .env and fill in the values you actually use.

# Telegram notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook notifier
WEBHOOK_URL=

# Desktop push notifications (UI edition). Generate with: npm run vapid:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional
LOG_LEVEL=info
