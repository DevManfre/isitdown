# Secrets are injected at runtime and never committed.
# Copy to .env and fill in the values you actually use.

# Telegram notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook notifier
WEBHOOK_URL=

# Discord notifier (server settings -> integrations -> webhooks)
DISCORD_WEBHOOK_URL=

# Slack notifier (incoming webhook of a Slack app)
SLACK_WEBHOOK_URL=

# Desktop push notifications (UI edition) need no variables: the server
# generates its own VAPID key pair on first use and stores it in the database.

# Optional
LOG_LEVEL=info
