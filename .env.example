# Secrets are injected at runtime and never committed.
# Copy to .env and fill in the values you actually use.

# Telegram notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook notifier
WEBHOOK_URL=
# Optional: signs every request with X-IsItDown-Signature (HMAC-SHA256 over
# "<timestamp>.<body>"). Leave empty to send unsigned requests.
WEBHOOK_SECRET=

# Discord notifier (server settings -> integrations -> webhooks)
DISCORD_WEBHOOK_URL=

# Slack notifier (incoming webhook of a Slack app)
SLACK_WEBHOOK_URL=

# ntfy notifier. The topic URL carries the server, so ntfy.sh and a
# self-hosted instance are the same setting.
NTFY_TOPIC_URL=
# Optional: only a server with access control needs a token. A public topic
# works with this left empty.
NTFY_TOKEN=

# Gotify notifier: the server, plus one of its application tokens.
GOTIFY_URL=
GOTIFY_TOKEN=

# Desktop push notifications (UI edition) need no variables: the server
# generates its own VAPID key pair on first use and stores it in the database.

# Optional
LOG_LEVEL=info
